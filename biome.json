{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "**/apps/web/**/*.ts",
      "**/apps/web/**/*.tsx",
      "**/packages/**/*",
      "!**/apps/web/.next/**/*",
      "!**/apps/web/out/**/*",
      "!**/node_modules/**/*",
      "!**/dist/**/*",
      "!**/.trigger/**/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
